{
  "openapi": "3.1.0",
  "info": {
    "title": "网维助手巡检后端",
    "version": "0.2.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "检查后端进程是否能响应",
        "description": "仅表示进程存活，不代表数据库、调度器或被测设备正常。",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/discovery-jobs": {
      "get": {
        "tags": [
          "discovery (read only)"
        ],
        "summary": "List Jobs",
        "operationId": "listDiscoveryJobs",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{1,18}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_JobView_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/discovery-jobs/{job_id}": {
      "get": {
        "tags": [
          "discovery (read only)"
        ],
        "summary": "Get Job",
        "operationId": "getDiscoveryJob",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/discovery-jobs/{job_id}/hosts": {
      "get": {
        "tags": [
          "discovery (read only)"
        ],
        "summary": "List Hosts",
        "operationId": "listDiscoveredHosts",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{1,18}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_HostView_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/discovery-jobs/{job_id}/probes": {
      "get": {
        "tags": [
          "discovery (read only)"
        ],
        "summary": "List Probes",
        "operationId": "listDiscoveryProbes",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{1,18}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "address",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Address"
            }
          },
          {
            "name": "method",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Method"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_ProbeView_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HostView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "jobId": {
            "type": "string",
            "title": "Jobid"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "mac": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mac"
          },
          "discoveryMethods": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Discoverymethods"
          },
          "context": {
            "additionalProperties": true,
            "type": "object",
            "title": "Context"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "direct_response",
              "candidate_only"
            ],
            "title": "Confidence"
          },
          "managementStatus": {
            "type": "string",
            "enum": [
              "discovered",
              "managed"
            ],
            "title": "Managementstatus"
          },
          "collectionAccess": {
            "type": "string",
            "enum": [
              "not_enrolled",
              "granted",
              "revoked"
            ],
            "title": "Collectionaccess"
          },
          "assetKind": {
            "type": "string",
            "title": "Assetkind"
          },
          "observedAt": {
            "type": "string",
            "title": "Observedat"
          },
          "openPorts": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Openports"
          },
          "assetSource": {
            "type": "string",
            "const": "network_discovery",
            "title": "Assetsource",
            "default": "network_discovery"
          },
          "hostMetrics": {
            "type": "null",
            "title": "Hostmetrics"
          },
          "hostMetricsStatus": {
            "type": "string",
            "const": "not_collected",
            "title": "Hostmetricsstatus",
            "default": "not_collected"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "jobId",
          "address",
          "mac",
          "discoveryMethods",
          "context",
          "confidence",
          "managementStatus",
          "collectionAccess",
          "assetKind",
          "observedAt",
          "openPorts"
        ],
        "title": "HostView"
      },
      "JobView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "scopeId": {
            "type": "string",
            "title": "Scopeid"
          },
          "scopeRevision": {
            "type": "integer",
            "title": "Scoperevision"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "partial",
              "failed",
              "interrupted"
            ],
            "title": "State"
          },
          "startedAt": {
            "type": "string",
            "title": "Startedat"
          },
          "finishedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finishedat"
          },
          "configSnapshot": {
            "additionalProperties": true,
            "type": "object",
            "title": "Configsnapshot"
          },
          "coverage": {
            "additionalProperties": true,
            "type": "object",
            "title": "Coverage"
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errorcode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "scopeId",
          "scopeRevision",
          "state",
          "startedAt",
          "finishedAt",
          "configSnapshot",
          "coverage",
          "errorCode"
        ],
        "title": "JobView"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "alive",
            "title": "Status",
            "default": "alive"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "LivenessResponse"
      },
      "Page_HostView_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/HostView"
            },
            "type": "array",
            "title": "Items"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "Page[HostView]"
      },
      "Page_JobView_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/JobView"
            },
            "type": "array",
            "title": "Items"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "Page[JobView]"
      },
      "Page_ProbeView_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProbeView"
            },
            "type": "array",
            "title": "Items"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "Page[ProbeView]"
      },
      "ProbeView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "jobId": {
            "type": "string",
            "title": "Jobid"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "port": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Port"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "durationMs": {
            "type": "number",
            "title": "Durationms"
          },
          "reasonCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoncode"
          },
          "evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence"
          },
          "observedAt": {
            "type": "string",
            "title": "Observedat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "jobId",
          "address",
          "phase",
          "method",
          "port",
          "status",
          "durationMs",
          "reasonCode",
          "evidence",
          "observedAt"
        ],
        "title": "ProbeView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}